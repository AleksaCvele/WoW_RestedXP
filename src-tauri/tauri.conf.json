{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Rested Tracker",
  "version": "1.0.0",
  "identifier": "com.restedsync.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WoW Rested Tracker",
        "width": 380,
        "height": 480,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "focus": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: https: http:",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Track rested XP for your WoW alts from the system tray",
    "longDescription": "A free, open-source system-tray widget that reads the RestedSync addon's SavedVariables and shows how much rested XP each of your World of Warcraft alts has built up while offline, including WoW Forever's Well Rested perk.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
